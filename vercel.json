{
  "version": 2,
  "rewrites": [
    {"source": "/pelis-demo/:path*", "destination": "/api/pelis-host-test?addonRoute=:path*"},
    {"source": "/nebula/:path*", "destination": "/api/nebula-extra?route=:path*"},
    {"source": "/juanita-demo/:path*", "destination": "/api/nebula-play?route=:path*"},
    {"source": "/", "destination": "/api/index?route="},
    {"source": "/manifest.json", "destination": "/api/index?route=manifest.json"},
    {"source": "/health", "destination": "/api/index?route=health"},
    {"source": "/catalog/:path*", "destination": "/api/index?route=catalog/:path*"},
    {"source": "/meta/:path*", "destination": "/api/index?route=meta/:path*"},
    {"source": "/stream/:path*", "destination": "/api/index?route=stream/:path*"}
  ],
  "outputDirectory": "public"
}
